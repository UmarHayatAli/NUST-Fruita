# Copy this file to .env and fill in the values. Never commit .env.
# config.js stops the server at startup if any required variable is missing.

# development | test | production
NODE_ENV=development
# API port
PORT=4000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fruita
DB_NAME_TEST=fruita_test

# API account: SELECT/INSERT/UPDATE/DELETE/EXECUTE only, no DDL (spec 8.5)
DB_APP_USER=fruita_app
DB_APP_PASSWORD=

# Migrations and seeds only: all privileges on fruita and fruita_test
DB_MIGRATOR_USER=fruita_migrator
DB_MIGRATOR_PASSWORD=

# Session signing key: 64 random hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# false in development, true in production (HTTPS)
COOKIE_SECURE=false

# First admin, used by seed S015 in production
ADMIN_INITIAL_EMAIL=admin@fruita.local
ADMIN_INITIAL_PASSWORD=

# Where product images are stored
UPLOAD_DIR=server/uploads
# Vite dev server origin (dev only)
CORS_ORIGIN=http://localhost:5173
